<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.resource-bar" path="/org/gnome/shell/extensions/resource-bar/">

    <key name="stats" type="as">
      <default>['cpu_usage', 'cpu_temp', 'ram_pct', 'net_rx', 'net_tx']</default>
      <summary>Metrics shown in the top bar, in order</summary>
      <description>Each item is an ID, or ID:mount-point for disk metrics (e.g. disk_used_pct:/mnt/data). IDs: cpu_usage, cpu_temp, cpu_freq, gpu_usage, gpu_temp, gpu_vram, gpu_vram_used, ram_pct, ram_used, swap_pct, disk_used_pct, disk_used, disk_free_pct, disk_free, disk_util, net_rx, net_tx.</description>
    </key>

    <key name="visualization" type="s">
      <choices>
        <choice value="gauge"/>
        <choice value="graph"/>
        <choice value="none"/>
      </choices>
      <default>'gauge'</default>
      <summary>Visualization next to the value (gauge, graph or none)</summary>
    </key>

    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Show icon</summary>
    </key>

    <key name="show-value" type="b">
      <default>true</default>
      <summary>Show value</summary>
    </key>

    <key name="show-units" type="b">
      <default>true</default>
      <summary>Show units in the value</summary>
    </key>

    <key name="show-cpu-cores" type="b">
      <default>false</default>
      <summary>Per-core gauge for CPU usage</summary>
    </key>

    <key name="label-min-width" type="i">
      <range min="0" max="200"/>
      <default>0</default>
      <summary>Minimum value width (px)</summary>
    </key>

    <key name="spacing" type="i">
      <range min="0" max="40"/>
      <default>10</default>
      <summary>Spacing between metrics (px)</summary>
    </key>

    <key name="smooth-animation" type="b">
      <default>true</default>
      <summary>Smooth animation</summary>
      <description>Gauges and graphs glide between readings over the update interval instead of jumping. Also follows GNOME's reduce animation setting.</description>
    </key>

    <key name="graph-colors" type="s">
      <choices>
        <choice value="default"/>
        <choice value="accent"/>
        <choice value="resources"/>
      </choices>
      <default>'default'</default>
      <summary>Graph colors</summary>
      <description>default: top bar text color; accent: GNOME accent color; resources: one color per resource, like the Resources app (CPU blue, memory purple, GPU red, disks orange, network teal). Only graphs change; gauges, icons and values do not. Above the thresholds they still move toward the alert color.</description>
    </key>

    <key name="highlight-color" type="s">
      <default>'#FD4663'</default>
      <summary>Alert color for high values</summary>
    </key>

    <key name="thresholds" type="a{s(dd)}">
      <default>{
        'cpu_usage': (50.0, 90.0),
        'cpu_temp': (60.0, 85.0),
        'cpu_freq': (2.5, 4.5),
        'gpu_usage': (50.0, 95.0),
        'gpu_temp': (60.0, 85.0),
        'gpu_vram': (50.0, 90.0),
        'ram': (60.0, 90.0),
        'swap': (20.0, 80.0),
        'disk': (80.0, 95.0),
        'disk_io': (50.0, 90.0),
        'net_rx': (1.0, 50.0),
        'net_tx': (1.0, 50.0)
      }</default>
      <summary>Thresholds (activity, critical) per metric group</summary>
    </key>

    <key name="disk-card-mode" type="s">
      <choices>
        <choice value="space"/>
        <choice value="activity"/>
      </choices>
      <default>'space'</default>
      <summary>Disks card: space used or activity</summary>
      <description>space: space used; activity: time spent reading/writing (like iostat %util) and speeds. Changed with the switch on the card itself.</description>
    </key>

    <key name="top-processes" type="i">
      <range min="0" max="5"/>
      <default>3</default>
      <summary>Number of top processes shown in the menu (0 = none)</summary>
    </key>

    <key name="processes-window" type="i">
      <range min="30" max="300"/>
      <default>60</default>
      <summary>Seconds over which the processes' CPU usage is averaged</summary>
    </key>

    <key name="processes-sort" type="s">
      <choices>
        <choice value="cpu"/>
        <choice value="memory"/>
      </choices>
      <default>'cpu'</default>
      <summary>Sort the menu's processes by CPU or memory use</summary>
      <description>Changed with the switch on the Processes card itself.</description>
    </key>

    <key name="pause-when-hidden" type="b">
      <default>true</default>
      <summary>Pause while a fullscreen app hides the top bar</summary>
      <description>Stops all readings (including nvidia-smi and the process list) while a fullscreen window on the primary monitor hides the top bar, and resumes with fresh readings when it is back.</description>
    </key>

    <key name="update-interval" type="d">
      <range min="0.5" max="10.0"/>
      <default>1.0</default>
      <summary>Update interval (seconds)</summary>
    </key>

    <key name="disk-path" type="s">
      <default>'/'</default>
      <summary>Default disk mount point</summary>
    </key>

    <key name="network-interface" type="s">
      <default>''</default>
      <summary>Network interface (empty = all physical ones)</summary>
    </key>

    <key name="network-speed-unit" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="kb"/>
        <choice value="mb"/>
      </choices>
      <default>'auto'</default>
      <summary>Network speed unit</summary>
    </key>

    <key name="network-speed-compact" type="b">
      <default>false</default>
      <summary>Compact network speed (e.g. 1.2M)</summary>
    </key>

    <key name="network-speed-decimals" type="i">
      <range min="0" max="2"/>
      <default>1</default>
      <summary>Decimal places in compact mode</summary>
    </key>

    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>'right'</default>
      <summary>Top bar area</summary>
    </key>

    <key name="panel-index" type="i">
      <range min="-1" max="50"/>
      <default>0</default>
      <summary>Position inside the area (-1 = last)</summary>
    </key>

  </schema>
</schemalist>
