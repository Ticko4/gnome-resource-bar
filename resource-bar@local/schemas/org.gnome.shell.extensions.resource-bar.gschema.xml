<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.resource-bar" path="/org/gnome/shell/extensions/resource-bar/">

    <key name="stats" type="as">
      <default>['cpu_usage', 'cpu_temp', 'ram_pct', 'net_rx', 'net_tx']</default>
      <summary>Métricas exibidas no painel, na ordem</summary>
      <description>Cada item é um ID ou ID:ponto-de-montagem para métricas de disco (ex.: disk_used_pct:/mnt/dados). IDs: cpu_usage, cpu_temp, cpu_freq, gpu_usage, gpu_temp, gpu_vram, gpu_vram_used, ram_pct, ram_used, swap_pct, disk_used_pct, disk_used, disk_free_pct, disk_free, disk_util, net_rx, net_tx.</description>
    </key>

    <key name="visualization" type="s">
      <choices>
        <choice value="gauge"/>
        <choice value="graph"/>
        <choice value="none"/>
      </choices>
      <default>'gauge'</default>
      <summary>Visualização ao lado do valor (medidor, gráfico ou nenhuma)</summary>
    </key>

    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Mostrar ícone</summary>
    </key>

    <key name="show-value" type="b">
      <default>true</default>
      <summary>Mostrar valor</summary>
    </key>

    <key name="show-units" type="b">
      <default>true</default>
      <summary>Mostrar unidades no valor</summary>
    </key>

    <key name="show-cpu-cores" type="b">
      <default>false</default>
      <summary>Medidor por núcleo no uso da CPU</summary>
    </key>

    <key name="label-min-width" type="i">
      <range min="0" max="200"/>
      <default>0</default>
      <summary>Largura mínima do valor (px)</summary>
    </key>

    <key name="spacing" type="i">
      <range min="0" max="40"/>
      <default>10</default>
      <summary>Espaço entre métricas (px)</summary>
    </key>

    <key name="smooth-animation" type="b">
      <default>true</default>
      <summary>Animação suave</summary>
      <description>Medidores e gráficos deslizam entre leituras durante o intervalo de atualização em vez de saltar. Também segue a opção do GNOME de reduzir animações.</description>
    </key>

    <key name="graph-colors" type="s">
      <choices>
        <choice value="default"/>
        <choice value="accent"/>
        <choice value="resources"/>
      </choices>
      <default>'default'</default>
      <summary>Cores dos gráficos</summary>
      <description>default: cor do texto do painel; accent: cor de destaque do GNOME; resources: uma cor por recurso, como no app Resources (CPU azul, memória roxo, GPU vermelho, discos laranja, rede azul-esverdeado). Só os gráficos mudam; barras, ícones e valores não. Acima dos limites continuam indo para a cor de alerta.</description>
    </key>

    <key name="highlight-color" type="s">
      <default>'#FD4663'</default>
      <summary>Cor de alerta para valores altos</summary>
    </key>

    <key name="thresholds" type="a{s(dd)}">
      <default>{
        'cpu_usage': (50.0, 90.0),
        'cpu_temp': (60.0, 85.0),
        'cpu_freq': (2.5, 4.5),
        'gpu_usage': (50.0, 95.0),
        'gpu_temp': (60.0, 85.0),
        'gpu_vram': (50.0, 90.0),
        'ram': (60.0, 90.0),
        'swap': (20.0, 80.0),
        'disk': (80.0, 95.0),
        'disk_io': (50.0, 90.0),
        'net_rx': (1.0, 50.0),
        'net_tx': (1.0, 50.0)
      }</default>
      <summary>Limites (atividade, crítico) por grupo de métrica</summary>
    </key>

    <key name="disk-card-mode" type="s">
      <choices>
        <choice value="space"/>
        <choice value="activity"/>
      </choices>
      <default>'space'</default>
      <summary>Cartão Discos: ocupação ou utilização</summary>
      <description>space: espaço usado; activity: tempo em leitura/gravação (como o %util do iostat) e velocidades. Trocado pelo seletor no próprio cartão.</description>
    </key>

    <key name="update-interval" type="d">
      <range min="0.5" max="10.0"/>
      <default>1.0</default>
      <summary>Intervalo de atualização (segundos)</summary>
    </key>

    <key name="disk-path" type="s">
      <default>'/'</default>
      <summary>Ponto de montagem monitorado</summary>
    </key>

    <key name="network-interface" type="s">
      <default>''</default>
      <summary>Interface de rede (vazio = todas as físicas)</summary>
    </key>

    <key name="network-speed-unit" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="kb"/>
        <choice value="mb"/>
      </choices>
      <default>'auto'</default>
      <summary>Unidade da velocidade de rede</summary>
    </key>

    <key name="network-speed-compact" type="b">
      <default>false</default>
      <summary>Velocidade de rede compacta (ex.: 1.2M)</summary>
    </key>

    <key name="network-speed-decimals" type="i">
      <range min="0" max="2"/>
      <default>1</default>
      <summary>Casas decimais no modo compacto</summary>
    </key>

    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>'right'</default>
      <summary>Área do painel</summary>
    </key>

    <key name="panel-index" type="i">
      <range min="-1" max="50"/>
      <default>0</default>
      <summary>Posição dentro da área (-1 = final)</summary>
    </key>

  </schema>
</schemalist>
