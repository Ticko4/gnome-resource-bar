#: resource-bar@ticko4.github.io/prefs.js:207
msgid "Move up"
msgstr "Переместить вверх"

#: resource-bar@ticko4.github.io/prefs.js:212
msgid "Move down"
msgstr "Переместить вниз"

#: resource-bar@ticko4.github.io/prefs.js:217
msgid "Remove"
msgstr "Удалить"

#: resource-bar@ticko4.github.io/prefs.js:224
msgid "Add metric"
msgstr "Добавить показатель"

#: resource-bar@ticko4.github.io/prefs.js:227
#, javascript-format
msgid "Default (%s)"
msgstr "По умолчанию (%s)"

#: resource-bar@ticko4.github.io/prefs.js:229
msgid "Disk"
