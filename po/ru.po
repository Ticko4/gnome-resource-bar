#: resource-bar@ticko4.github.io/prefs.js:237
msgid "Add"
msgstr "Добавить"

#: resource-bar@ticko4.github.io/prefs.js:258
msgid "All disks"
msgstr "Все диски"

#. TRANSLATORS: %s is a list of disk names.
#: resource-bar@ticko4.github.io/prefs.js:261
msgid "Adds “Disk used (%)” for: %s"
msgstr "Добавляет «Занято на диске (%)» для: %s"

#: resource-bar@ticko4.github.io/prefs.js:262
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "%d обнаруженный диск уже на верхней панели"
msgstr[1] "Все %d обнаруженных диска уже на верхней панели"
msgstr[2] "Все %d обнаруженных дисков уже на верхней панели"

#: resource-bar@ticko4.github.io/prefs.js:266
msgid "Add all"
msgstr "Добавить все"

#: resource-bar@ticko4.github.io/prefs.js:284
msgid "Appearance"
msgstr "Внешний вид"

#: resource-bar@ticko4.github.io/prefs.js:285
msgid "Visualization"
msgstr "Визуализация"

#: resource-bar@ticko4.github.io/prefs.js:286
msgid "Show icon"
msgstr "Показывать значок"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Show value"
msgstr "Показывать значение"

#: resource-bar@ticko4.github.io/prefs.js:292
msgid "Value style"
msgstr "Стиль значения"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Show units"
msgstr "Показывать единицы измерения"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Off: “45” instead of “45°C”"
msgstr "Выключено: «45» вместо «45°C»"

#: resource-bar@ticko4.github.io/prefs.js:297
msgid "Per-core gauge"
msgstr "Индикатор по ядрам"

#: resource-bar@ticko4.github.io/prefs.js:298
msgid "For CPU usage in gauge mode, one bar per core"
msgstr "Для загрузки CPU в режиме индикатора — по одной полосе на ядро"

#: resource-bar@ticko4.github.io/prefs.js:301
msgid "Minimum value width"
msgstr "Минимальная ширина значения"

#: resource-bar@ticko4.github.io/prefs.js:302
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "В пикселях; резервирует место, чтобы верхняя панель не смещалась"

#: resource-bar@ticko4.github.io/prefs.js:303
msgid "Spacing between metrics"
msgstr "Расстояние между показателями"

#: resource-bar@ticko4.github.io/prefs.js:305
msgid "Smooth animation"
msgstr "Плавная анимация"

#: resource-bar@ticko4.github.io/prefs.js:306
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Индикаторы и графики плавно переходят между измерениями, а не скачут при "
"каждом обновлении"

#: resource-bar@ticko4.github.io/prefs.js:307
msgid "Graph colors"
msgstr "Цвета графиков"

#: resource-bar@ticko4.github.io/prefs.js:308
msgid "Applies to graphs and pills only"
msgstr "Только для графиков и капсул"

#: resource-bar@ticko4.github.io/prefs.js:309
msgid "Time shown in graphs"
msgstr "Период на графиках"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "30 seconds"
msgstr "30 секунд"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "1 minute"
msgstr "1 минута"

#: resource-bar@ticko4.github.io/prefs.js:310
msgid "2 minutes"
msgstr "2 минуты"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "5 minutes"
msgstr "5 минут"

#: resource-bar@ticko4.github.io/prefs.js:313
msgid "Alert color"
msgstr "Цвет предупреждения"

#: resource-bar@ticko4.github.io/prefs.js:314
msgid "Used when a value goes past its activity and critical thresholds"
msgstr ""
"Используется, когда значение превышает порог активности и критический порог"

#: resource-bar@ticko4.github.io/prefs.js:335
msgid "Reset to default"
msgstr "Восстановить по умолчанию"

#: resource-bar@ticko4.github.io/prefs.js:348
msgid "Menu"
msgstr "Меню"

#: resource-bar@ticko4.github.io/prefs.js:349
msgid "Top processes"
msgstr "Самые активные процессы"

#: resource-bar@ticko4.github.io/prefs.js:351
msgid "Processes using the most CPU or memory, listed in the menu"
msgstr "Процессы, использующие больше всего CPU или памяти, в меню"

#: resource-bar@ticko4.github.io/prefs.js:352
msgid "CPU average"
msgstr "Среднее CPU"

#: resource-bar@ticko4.github.io/prefs.js:354
msgid "Time span of the processes’ CPU usage; memory is the current value"
msgstr "Период для использования CPU процессами; память — текущее значение"

#: resource-bar@ticko4.github.io/prefs.js:358
msgid "Position"
msgstr "Расположение"

#: resource-bar@ticko4.github.io/prefs.js:359
msgid "Top bar area"
msgstr "Область верхней панели"

#: resource-bar@ticko4.github.io/prefs.js:360
msgid "Position in the area"
msgstr "Позиция в области"

#: resource-bar@ticko4.github.io/prefs.js:361
msgid "0 = first item; -1 = last"
msgstr "0 = первый элемент; -1 = последний"

#: resource-bar@ticko4.github.io/prefs.js:370
msgid "Monitoring"
msgstr "Мониторинг"

#: resource-bar@ticko4.github.io/prefs.js:372
msgid "General"
msgstr "Общие"

#: resource-bar@ticko4.github.io/prefs.js:373
msgid "Update interval"
msgstr "Интервал обновления"

#: resource-bar@ticko4.github.io/prefs.js:374
msgid "Seconds between readings"
msgstr "Секунды между измерениями"

#: resource-bar@ticko4.github.io/prefs.js:375
msgid "Pause in fullscreen"
msgstr "Пауза в полноэкранном режиме"

#: resource-bar@ticko4.github.io/prefs.js:376
msgid "Stop reading data while a fullscreen app or game hides the top bar"
msgstr ""
"Не считывать данные, пока полноэкранное приложение или игра скрывает верхнюю "
"панель"

#: resource-bar@ticko4.github.io/prefs.js:380
msgid "Default disk"
msgstr "Диск по умолчанию"

#: resource-bar@ticko4.github.io/prefs.js:381
msgid ""
"Used by disk metrics that do not name a specific disk. The menu always lists "
"every disk."
msgstr ""
"Используется показателями диска, для которых не указан конкретный диск. В "
"меню всегда показаны все диски."

#: resource-bar@ticko4.github.io/prefs.js:384
msgid "Mount point"
msgstr "Точка монтирования"

#: resource-bar@ticko4.github.io/prefs.js:395
#: resource-bar@ticko4.github.io/lib/popup.js:320
msgid "Network"
msgstr "Сеть"

#: resource-bar@ticko4.github.io/prefs.js:400
msgid "Interface"
msgstr "Интерфейс"

#: resource-bar@ticko4.github.io/prefs.js:401
msgid "Automatic (physical interfaces)"
msgstr "Автоматически (физические интерфейсы)"

#: resource-bar@ticko4.github.io/prefs.js:402
msgid "Unit"
msgstr "Единица измерения"

#: resource-bar@ticko4.github.io/prefs.js:403
msgid "Compact format"
msgstr "Компактный формат"

#: resource-bar@ticko4.github.io/prefs.js:403
msgid "E.g. “1.2M” instead of “1.2 MB/s”"
msgstr "Например, «1.2M» вместо «1.2 MB/s»"

#: resource-bar@ticko4.github.io/prefs.js:404
msgid "Decimal places (compact)"
msgstr "Знаки после запятой (компактный формат)"

#: resource-bar@ticko4.github.io/prefs.js:413
msgid "Thresholds"
msgstr "Пороги"

#: resource-bar@ticko4.github.io/prefs.js:415
msgid "Color thresholds"
msgstr "Цветовые пороги"

#: resource-bar@ticko4.github.io/prefs.js:416
msgid ""
"Below the activity threshold a metric uses the normal top bar color. Between "
"activity and critical it moves toward the alert color, and at critical it is "
"fully that color."
msgstr ""
"Ниже порога активности показатель имеет обычный цвет верхней панели. Между "
"порогом активности и критическим порогом цвет постепенно меняется к цвету "
"предупреждения, а на критическом пороге полностью ему соответствует."

#: resource-bar@ticko4.github.io/prefs.js:444
msgid "Activity"
msgstr "Активность"

#: resource-bar@ticko4.github.io/prefs.js:445
msgid "Critical"
msgstr "Критический"

#: resource-bar@ticko4.github.io/prefs.js:469
