msgid "Show units"
msgstr "Mértékegységek megjelenítése"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Off: “45” instead of “45°C”"
msgstr "Kikapcsolva: „45” a „45°C” helyett"

