msgstr "Dodaje „Zajęte miejsce na dysku (%)” dla: %s"

#: resource-bar@ticko4.github.io/prefs.js:262
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "%d wykryty dysk jest już na górnym pasku"
msgstr[1] "Wszystkie %d wykryte dyski są już na górnym pasku"
msgstr[2] "Wszystkich %d wykrytych dysków jest już na górnym pasku"

#: resource-bar@ticko4.github.io/prefs.js:266
msgid "Add all"
msgstr "Dodaj wszystkie"

