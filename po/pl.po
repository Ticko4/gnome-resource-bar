msgid "Show icon"
msgstr "Wyświetlanie ikony"

#: resource-bar@ticko4.github.io/prefs.js:276
msgid "Show value"
msgstr "Wyświetlanie wartości"

#: resource-bar@ticko4.github.io/prefs.js:279
msgid "Value style"
msgstr "Styl wartości"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Show units"
msgstr "Wyświetlanie jednostek"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Off: “45” instead of “45°C”"
msgstr "Wyłączone: „45” zamiast „45°C”"

#: resource-bar@ticko4.github.io/prefs.js:290
msgid "Per-core gauge"
msgstr "Wskaźnik dla każdego rdzenia"

#: resource-bar@ticko4.github.io/prefs.js:291
msgid "For CPU usage in gauge mode, one bar per core"
msgstr "Dla użycia CPU w trybie wskaźnika: jeden słupek na rdzeń"

#: resource-bar@ticko4.github.io/prefs.js:292
msgid "Minimum value width"
msgstr "Minimalna szerokość wartości"

#: resource-bar@ticko4.github.io/prefs.js:293
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "W pikselach; rezerwuje miejsce, aby górny pasek się nie przesuwał"

#: resource-bar@ticko4.github.io/prefs.js:294
msgid "Spacing between metrics"
msgstr "Odstęp między metrykami"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Smooth animation"
msgstr "Płynna animacja"

#: resource-bar@ticko4.github.io/prefs.js:297
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Wskaźniki i wykresy płynnie przechodzą między odczytami zamiast przeskakiwać "
"przy każdej aktualizacji"

#: resource-bar@ticko4.github.io/prefs.js:298
msgid "Graph colors"
msgstr "Kolory wykresów"

#: resource-bar@ticko4.github.io/prefs.js:299
msgid "Only graphs change; gauges, icons and values stay as they are"
msgstr ""
"Zmieniają się tylko wykresy; wskaźniki, ikony i wartości pozostają bez zmian"

#: resource-bar@ticko4.github.io/prefs.js:300
msgid "Time shown in graphs"
msgstr "Okres widoczny na wykresach"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "30 seconds"
msgstr "30 sekund"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "1 minute"
msgstr "1 minuta"

#: resource-bar@ticko4.github.io/prefs.js:301
msgid "2 minutes"
msgstr "2 minuty"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "5 minutes"
msgstr "5 minut"

#: resource-bar@ticko4.github.io/prefs.js:304
msgid "Alert color"
msgstr "Kolor ostrzeżenia"

#: resource-bar@ticko4.github.io/prefs.js:305
msgid "Used when a value goes past its activity and critical thresholds"
msgstr "Używany, gdy wartość przekracza próg aktywności i próg krytyczny"

#: resource-bar@ticko4.github.io/prefs.js:326
msgid "Reset to default"
msgstr "Przywróć domyślne"

