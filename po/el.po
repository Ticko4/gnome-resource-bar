#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "Ο %d δίσκος που εντοπίστηκε βρίσκεται ήδη στην πάνω γραμμή"
msgstr[1] "Και οι %d δίσκοι που εντοπίστηκαν βρίσκονται ήδη στην πάνω γραμμή"

