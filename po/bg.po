#: resource-bar@ticko4.github.io/prefs.js:152
msgid "Top Bar"
msgstr "Горна лента"

#: resource-bar@ticko4.github.io/prefs.js:155
msgid "Metrics in the top bar"
msgstr "Показатели в горната лента"

#: resource-bar@ticko4.github.io/prefs.js:156
msgid ""
"Each metric becomes an item with an icon, a gauge or graph and its value, "
"like Noctalia’s sysmon widget."
msgstr ""
"Всеки показател става елемент с икона, индикатор или графика и стойност, "
"като джаджата sysmon в Noctalia."

#: resource-bar@ticko4.github.io/prefs.js:179
#, javascript-format
msgid "default (%s)"
msgstr "стандартно (%s)"

#: resource-bar@ticko4.github.io/prefs.js:196
msgid "Move up"
msgstr "Преместване нагоре"

#: resource-bar@ticko4.github.io/prefs.js:201
msgid "Move down"
msgstr "Преместване надолу"

#: resource-bar@ticko4.github.io/prefs.js:206
msgid "Remove"
msgstr "Премахване"

#: resource-bar@ticko4.github.io/prefs.js:213
msgid "Add metric"
msgstr "Добавяне на показател"

#: resource-bar@ticko4.github.io/prefs.js:216
#, javascript-format
msgid "Default (%s)"
msgstr "Стандартно (%s)"

#: resource-bar@ticko4.github.io/prefs.js:218
msgid "Disk"
msgstr "Диск"

#: resource-bar@ticko4.github.io/prefs.js:226
msgid "Add"
msgstr "Добавяне"

#: resource-bar@ticko4.github.io/prefs.js:247
msgid "All disks"
msgstr "Всички дискове"

#. TRANSLATORS: %s is a list of disk names.
#: resource-bar@ticko4.github.io/prefs.js:250
msgid "Adds “Disk used (%)” for: %s"
msgstr "Добавя „Заето място на диска (%)“ за: %s"

#: resource-bar@ticko4.github.io/prefs.js:251
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "%d открит диск вече е в горната лента"
msgstr[1] "Всички %d открити диска вече са в горната лента"

#: resource-bar@ticko4.github.io/prefs.js:255
msgid "Add all"
msgstr "Добавяне на всички"

#: resource-bar@ticko4.github.io/prefs.js:273
msgid "Appearance"
msgstr "Външен вид"

#: resource-bar@ticko4.github.io/prefs.js:274
msgid "Visualization"
msgstr "Визуализация"

#: resource-bar@ticko4.github.io/prefs.js:275
msgid "Show icon"
msgstr "Показване на икона"

#: resource-bar@ticko4.github.io/prefs.js:276
msgid "Show value"
msgstr "Показване на стойност"

#: resource-bar@ticko4.github.io/prefs.js:279
msgid "Value style"
msgstr "Стил на стойността"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Show units"
msgstr "Показване на мерни единици"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Off: “45” instead of “45°C”"
msgstr "Изключено: „45“ вместо „45°C“"

#: resource-bar@ticko4.github.io/prefs.js:290
msgid "Per-core gauge"
msgstr "Индикатор за всяко ядро"

#: resource-bar@ticko4.github.io/prefs.js:291
msgid "For CPU usage in gauge mode, one bar per core"
msgstr ""
"За натоварването на CPU в режим на индикатор — по едно стълбче за всяко ядро"

#: resource-bar@ticko4.github.io/prefs.js:292
msgid "Minimum value width"
msgstr "Минимална ширина на стойността"

#: resource-bar@ticko4.github.io/prefs.js:293
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "В пиксели; запазва място, за да не се измества горната лента"

#: resource-bar@ticko4.github.io/prefs.js:294
msgid "Spacing between metrics"
msgstr "Разстояние между показателите"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Smooth animation"
msgstr "Плавна анимация"

#: resource-bar@ticko4.github.io/prefs.js:297
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Индикаторите и графиките преминават плавно между измерванията, вместо да "
"скачат при всяко обновяване"

#: resource-bar@ticko4.github.io/prefs.js:298
msgid "Graph colors"
msgstr "Цветове на графиките"

#: resource-bar@ticko4.github.io/prefs.js:299
msgid "Only graphs change; gauges, icons and values stay as they are"
msgstr ""
"Променят се само графиките; индикаторите, иконите и стойностите остават "
"същите"

#: resource-bar@ticko4.github.io/prefs.js:300
msgid "Time shown in graphs"
msgstr "Период, показан в графиките"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "30 seconds"
msgstr "30 секунди"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "1 minute"
msgstr "1 минута"

#: resource-bar@ticko4.github.io/prefs.js:301
msgid "2 minutes"
msgstr "2 минути"

#: resource-bar@ticko4.github.io/prefs.js:301
#: resource-bar@ticko4.github.io/prefs.js:344
msgid "5 minutes"
msgstr "5 минути"

#: resource-bar@ticko4.github.io/prefs.js:304
msgid "Alert color"
msgstr "Цвят за предупреждение"

#: resource-bar@ticko4.github.io/prefs.js:305
msgid "Used when a value goes past its activity and critical thresholds"
msgstr ""
"Използва се, когато стойността премине прага на активност и критичния праг"

#: resource-bar@ticko4.github.io/prefs.js:326
msgid "Reset to default"
msgstr "Връщане към стандартното"

#: resource-bar@ticko4.github.io/prefs.js:339
msgid "Menu"
msgstr "Меню"

#: resource-bar@ticko4.github.io/prefs.js:340
msgid "Top processes"
msgstr "Най-натоварващи процеси"

#: resource-bar@ticko4.github.io/prefs.js:342
msgid "Processes using the most CPU or memory, listed in the menu"
msgstr "Процесите, които използват най-много CPU или памет, показани в менюто"

#: resource-bar@ticko4.github.io/prefs.js:343
msgid "CPU average"
msgstr "Средно CPU"

#: resource-bar@ticko4.github.io/prefs.js:345
msgid "Time span of the processes’ CPU usage; memory is the current value"
msgstr ""
"Период на използването на CPU от процесите; паметта е текущата стойност"

#: resource-bar@ticko4.github.io/prefs.js:349
msgid "Position"
msgstr "Позиция"

#: resource-bar@ticko4.github.io/prefs.js:350
msgid "Top bar area"
msgstr "Област на горната лента"

#: resource-bar@ticko4.github.io/prefs.js:351
msgid "Position in the area"
msgstr "Позиция в областта"

#: resource-bar@ticko4.github.io/prefs.js:352
msgid "0 = first item; -1 = last"
msgstr "0 = първи елемент; -1 = последен"

#: resource-bar@ticko4.github.io/prefs.js:361
msgid "Monitoring"
msgstr "Наблюдение"

#: resource-bar@ticko4.github.io/prefs.js:363
msgid "General"
msgstr "Общи"

#: resource-bar@ticko4.github.io/prefs.js:364
msgid "Update interval"
msgstr "Интервал на обновяване"

#: resource-bar@ticko4.github.io/prefs.js:365
msgid "Seconds between readings"
msgstr "Секунди между измерванията"

#: resource-bar@ticko4.github.io/prefs.js:366
msgid "Pause in fullscreen"
msgstr "Пауза при цял екран"

#: resource-bar@ticko4.github.io/prefs.js:367
msgid "Stop reading data while a fullscreen app or game hides the top bar"
msgstr ""
"Спиране на четенето на данни, докато приложение или игра на цял екран скрива "
"горната лента"

#: resource-bar@ticko4.github.io/prefs.js:371
msgid "Default disk"
msgstr "Стандартен диск"

#: resource-bar@ticko4.github.io/prefs.js:372
msgid ""
"Used by disk metrics that do not name a specific disk. The menu always lists "
"every disk."
msgstr ""
"Използва се от показателите за диск, които не посочват конкретен диск. "
"Менюто винаги показва всички дискове."

#: resource-bar@ticko4.github.io/prefs.js:375
msgid "Mount point"
msgstr "Точка на монтиране"

#: resource-bar@ticko4.github.io/prefs.js:386
#: resource-bar@ticko4.github.io/lib/popup.js:320
msgid "Network"
msgstr "Мрежа"

#: resource-bar@ticko4.github.io/prefs.js:391
msgid "Interface"
msgstr "Интерфейс"

#: resource-bar@ticko4.github.io/prefs.js:392
msgid "Automatic (physical interfaces)"
msgstr "Автоматично (физически интерфейси)"

#: resource-bar@ticko4.github.io/prefs.js:393
msgid "Unit"
msgstr "Мерна единица"

#: resource-bar@ticko4.github.io/prefs.js:394
msgid "Compact format"
msgstr "Компактен формат"

#: resource-bar@ticko4.github.io/prefs.js:394
msgid "E.g. “1.2M” instead of “1.2 MB/s”"
msgstr "Напр. „1.2M“ вместо „1.2 MB/s“"

#: resource-bar@ticko4.github.io/prefs.js:395
msgid "Decimal places (compact)"
msgstr "Десетични знаци (компактен формат)"

#: resource-bar@ticko4.github.io/prefs.js:404
msgid "Thresholds"
msgstr "Прагове"

#: resource-bar@ticko4.github.io/prefs.js:406
msgid "Color thresholds"
msgstr "Цветови прагове"

#: resource-bar@ticko4.github.io/prefs.js:407
msgid ""
"Below the activity threshold a metric uses the normal top bar color. Between "
"activity and critical it moves toward the alert color, and at critical it is "
"fully that color."
msgstr ""
"Под прага на активност показателят е в обичайния цвят на горната лента. "
"Между прага на активност и критичния праг цветът постепенно преминава към "
"цвета за предупреждение, а при критичния праг е изцяло в този цвят."

#: resource-bar@ticko4.github.io/prefs.js:435
msgid "Activity"
msgstr "Активност"

#: resource-bar@ticko4.github.io/prefs.js:436
msgid "Critical"
msgstr "Критичен"

#: resource-bar@ticko4.github.io/prefs.js:460
