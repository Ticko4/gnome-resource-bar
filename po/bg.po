#. TRANSLATORS: %s is the system monitor app, e.g. "Resources".
#: resource-bar@ticko4.github.io/extension.js:91
#, javascript-format
msgid "Open %s"
msgstr "Отваряне на %s"

#: resource-bar@ticko4.github.io/extension.js:94
msgid "Settings"
msgstr "Настройки"

#: resource-bar@ticko4.github.io/prefs.js:15
msgid "Gauge"
msgstr "Индикатор"

#: resource-bar@ticko4.github.io/prefs.js:16
msgid "Graph"
msgstr "Графика"

#: resource-bar@ticko4.github.io/prefs.js:17
msgid "None"
msgstr "Без"

#: resource-bar@ticko4.github.io/prefs.js:21
msgid "Default (text color)"
msgstr "Стандартни (цвета на текста)"

#: resource-bar@ticko4.github.io/prefs.js:22
msgid "System accent color"
msgstr "Системен акцентен цвят"

#: resource-bar@ticko4.github.io/prefs.js:23
msgid "Per resource (like Resources)"
msgstr "По ресурс (както в Resources)"

#: resource-bar@ticko4.github.io/prefs.js:27
msgid "Left"
msgstr "Отляво"

#: resource-bar@ticko4.github.io/prefs.js:28
msgid "Center"
msgstr "В центъра"

#: resource-bar@ticko4.github.io/prefs.js:29
msgid "Right"
msgstr "Отдясно"

#: resource-bar@ticko4.github.io/prefs.js:33
msgid "Automatic"
msgstr "Автоматично"

#: resource-bar@ticko4.github.io/prefs.js:113
msgid "Top Bar"
msgstr "Горна лента"

#: resource-bar@ticko4.github.io/prefs.js:116
msgid "Metrics in the top bar"
msgstr "Показатели в горната лента"

#: resource-bar@ticko4.github.io/prefs.js:117
msgid ""
"Each metric becomes an item with an icon, a gauge or graph and its value, "
"like Noctalia’s sysmon widget."
msgstr ""
"Всеки показател става елемент с икона, индикатор или графика и стойност, "
"като джаджата sysmon в Noctalia."

#: resource-bar@ticko4.github.io/prefs.js:140
#, javascript-format
msgid "default (%s)"
msgstr "стандартно (%s)"

#: resource-bar@ticko4.github.io/prefs.js:157
msgid "Move up"
msgstr "Преместване нагоре"

#: resource-bar@ticko4.github.io/prefs.js:162
msgid "Move down"
msgstr "Преместване надолу"

#: resource-bar@ticko4.github.io/prefs.js:167
msgid "Remove"
msgstr "Премахване"

#: resource-bar@ticko4.github.io/prefs.js:174
msgid "Add metric"
msgstr "Добавяне на показател"

#: resource-bar@ticko4.github.io/prefs.js:177
#, javascript-format
msgid "Default (%s)"
msgstr "Стандартно (%s)"

#: resource-bar@ticko4.github.io/prefs.js:179
msgid "Disk"
msgstr "Диск"

#: resource-bar@ticko4.github.io/prefs.js:187
msgid "Add"
msgstr "Добавяне"

#: resource-bar@ticko4.github.io/prefs.js:208
msgid "All disks"
msgstr "Всички дискове"

#. TRANSLATORS: %s is a list of disk names.
#: resource-bar@ticko4.github.io/prefs.js:211
msgid "Adds “Disk used (%)” for: %s"
msgstr "Добавя „Заето място на диска (%)“ за: %s"

#: resource-bar@ticko4.github.io/prefs.js:212
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "%d открит диск вече е в горната лента"
msgstr[1] "Всички %d открити диска вече са в горната лента"

#: resource-bar@ticko4.github.io/prefs.js:216
msgid "Add all"
msgstr "Добавяне на всички"

#: resource-bar@ticko4.github.io/prefs.js:234
msgid "Appearance"
msgstr "Външен вид"

#: resource-bar@ticko4.github.io/prefs.js:235
msgid "Visualization"
msgstr "Визуализация"

#: resource-bar@ticko4.github.io/prefs.js:236
msgid "Vertical pill gauge or a graph of the last 30 readings"
msgstr ""
"Вертикален индикатор с форма на капсула или графика на последните 30 "
"измервания"

#: resource-bar@ticko4.github.io/prefs.js:237
msgid "Show icon"
msgstr "Показване на икона"

#: resource-bar@ticko4.github.io/prefs.js:238
msgid "Show value"
msgstr "Показване на стойност"

#: resource-bar@ticko4.github.io/prefs.js:239
msgid "Show units"
msgstr "Показване на мерни единици"

#: resource-bar@ticko4.github.io/prefs.js:239
msgid "Off: “45” instead of “45°C”"
msgstr "Изключено: „45“ вместо „45°C“"

#: resource-bar@ticko4.github.io/prefs.js:240
msgid "Per-core gauge"
msgstr "Индикатор за всяко ядро"

#: resource-bar@ticko4.github.io/prefs.js:241
msgid "For CPU usage in gauge mode, one bar per core"
msgstr ""
"За натоварването на CPU в режим на индикатор — по едно стълбче за всяко ядро"

#: resource-bar@ticko4.github.io/prefs.js:242
msgid "Minimum value width"
msgstr "Минимална ширина на стойността"

#: resource-bar@ticko4.github.io/prefs.js:243
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "В пиксели; запазва място, за да не се измества горната лента"

#: resource-bar@ticko4.github.io/prefs.js:244
msgid "Spacing between metrics"
msgstr "Разстояние между показателите"

#: resource-bar@ticko4.github.io/prefs.js:246
msgid "Smooth animation"
msgstr "Плавна анимация"

#: resource-bar@ticko4.github.io/prefs.js:247
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Индикаторите и графиките преминават плавно между измерванията, вместо да "
"скачат при всяко обновяване"

#: resource-bar@ticko4.github.io/prefs.js:248
msgid "Graph colors"
msgstr "Цветове на графиките"

#: resource-bar@ticko4.github.io/prefs.js:249
msgid "Only graphs change; gauges, icons and values stay as they are"
msgstr ""
"Променят се само графиките; индикаторите, иконите и стойностите остават "
"същите"

#: resource-bar@ticko4.github.io/prefs.js:252
msgid "Alert color"
msgstr "Цвят за предупреждение"

#: resource-bar@ticko4.github.io/prefs.js:253
msgid "Used when a value goes past its activity and critical thresholds"
msgstr ""
"Използва се, когато стойността премине прага на активност и критичния праг"

#: resource-bar@ticko4.github.io/prefs.js:274
msgid "Reset to default"
msgstr "Връщане към стандартното"

#: resource-bar@ticko4.github.io/prefs.js:287
msgid "Position"
msgstr "Позиция"

#: resource-bar@ticko4.github.io/prefs.js:288
msgid "Top bar area"
msgstr "Област на горната лента"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Position in the area"
msgstr "Позиция в областта"

#: resource-bar@ticko4.github.io/prefs.js:290
msgid "0 = first item; -1 = last"
msgstr "0 = първи елемент; -1 = последен"

#: resource-bar@ticko4.github.io/prefs.js:299
msgid "Monitoring"
msgstr "Наблюдение"

#: resource-bar@ticko4.github.io/prefs.js:301
msgid "General"
msgstr "Общи"

#: resource-bar@ticko4.github.io/prefs.js:302
msgid "Update interval"
msgstr "Интервал на обновяване"

#: resource-bar@ticko4.github.io/prefs.js:303
msgid "Seconds between readings"
msgstr "Секунди между измерванията"

#: resource-bar@ticko4.github.io/prefs.js:307
msgid "Default disk"
msgstr "Стандартен диск"

#: resource-bar@ticko4.github.io/prefs.js:308
msgid ""
"Used by disk metrics that do not name a specific disk. The menu always lists "
"every disk."
msgstr ""
"Използва се от показателите за диск, които не посочват конкретен диск. "
"Менюто винаги показва всички дискове."

#: resource-bar@ticko4.github.io/prefs.js:311
msgid "Mount point"
msgstr "Точка на монтиране"

#: resource-bar@ticko4.github.io/prefs.js:322
#: resource-bar@ticko4.github.io/lib/popup.js:227
msgid "Network"
msgstr "Мрежа"

#: resource-bar@ticko4.github.io/prefs.js:327
msgid "Interface"
msgstr "Интерфейс"

#: resource-bar@ticko4.github.io/prefs.js:328
msgid "Automatic (physical interfaces)"
msgstr "Автоматично (физически интерфейси)"

#: resource-bar@ticko4.github.io/prefs.js:329
msgid "Unit"
msgstr "Мерна единица"

#: resource-bar@ticko4.github.io/prefs.js:330
msgid "Compact format"
msgstr "Компактен формат"

#: resource-bar@ticko4.github.io/prefs.js:330
msgid "E.g. “1.2M” instead of “1.2 MB/s”"
msgstr "Напр. „1.2M“ вместо „1.2 MB/s“"

#: resource-bar@ticko4.github.io/prefs.js:331
msgid "Decimal places (compact)"
msgstr "Десетични знаци (компактен формат)"

#: resource-bar@ticko4.github.io/prefs.js:340
msgid "Thresholds"
msgstr "Прагове"

#: resource-bar@ticko4.github.io/prefs.js:342
msgid "Color thresholds"
msgstr "Цветови прагове"

#: resource-bar@ticko4.github.io/prefs.js:343
msgid ""
"Below the activity threshold a metric uses the normal top bar color. Between "
"activity and critical it moves toward the alert color, and at critical it is "
"fully that color."
msgstr ""
"Под прага на активност показателят е в обичайния цвят на горната лента. "
"Между прага на активност и критичния праг цветът постепенно преминава към "
"цвета за предупреждение, а при критичния праг е изцяло в този цвят."

#: resource-bar@ticko4.github.io/prefs.js:371
msgid "Activity"
msgstr "Активност"

#: resource-bar@ticko4.github.io/prefs.js:372
msgid "Critical"
msgstr "Критичен"

#: resource-bar@ticko4.github.io/prefs.js:396
msgid "Reset thresholds"
msgstr "Връщане на стандартните прагове"

#: resource-bar@ticko4.github.io/lib/popup.js:226
#: resource-bar@ticko4.github.io/lib/stats.js:35
msgid "Memory"
msgstr "Памет"

#: resource-bar@ticko4.github.io/lib/popup.js:228
msgid "Disks"
msgstr "Дискове"

#: resource-bar@ticko4.github.io/lib/popup.js:238
msgctxt "disks card"
msgid "Space"
msgstr "Място"

#: resource-bar@ticko4.github.io/lib/popup.js:239
msgctxt "disks card"
msgid "Activity"
msgstr "Активност"

