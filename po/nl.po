msgid "CPU average"
msgstr "CPU-gemiddelde"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "30 seconds"
msgstr "30 seconden"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "1 minute"
msgstr "1 minuut"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "5 minutes"
msgstr "5 minuten"

#: resource-bar@ticko4.github.io/prefs.js:326
msgid "Time span of the processes’ CPU usage; memory is the current value"
msgstr ""
"Periode van het CPU-gebruik van processen; geheugen is de huidige waarde"

