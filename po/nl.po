msgstr "Voegt ‘Gebruikte schijfruimte (%)’ toe voor: %s"

#: resource-bar@ticko4.github.io/prefs.js:245
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "De %d gedetecteerde schijf staat al in de bovenbalk"
msgstr[1] "Alle %d gedetecteerde schijven staan al in de bovenbalk"

