msgid "Pause in fullscreen"
msgstr "Pozastaviť na celej obrazovke"

#: resource-bar@ticko4.github.io/prefs.js:376
msgid "Stop reading data while a fullscreen app or game hides the top bar"
msgstr ""
"Prestať čítať údaje, keď aplikácia alebo hra na celú obrazovku skryje horný "
"panel"

#: resource-bar@ticko4.github.io/prefs.js:380
msgid "Default disk"
msgstr "Predvolený disk"

#: resource-bar@ticko4.github.io/prefs.js:381
msgid ""
"Used by disk metrics that do not name a specific disk. The menu always lists "
"every disk."
msgstr ""
"Používa sa pre metriky disku, ktoré neuvádzajú konkrétny disk. Ponuka vždy "
"zobrazuje všetky disky."

