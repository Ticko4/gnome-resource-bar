msgid "Visualization"
msgstr "Vizualizácia"

#: resource-bar@ticko4.github.io/prefs.js:286
msgid "Show icon"
msgstr "Zobraziť ikonu"

#: resource-bar@ticko4.github.io/prefs.js:289
msgid "Show value"
msgstr "Zobraziť hodnotu"

#: resource-bar@ticko4.github.io/prefs.js:292
msgid "Value style"
msgstr "Štýl hodnoty"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Show units"
msgstr "Zobraziť jednotky"

#: resource-bar@ticko4.github.io/prefs.js:296
msgid "Off: “45” instead of “45°C”"
msgstr "Vypnuté: „45“ namiesto „45°C“"

#: resource-bar@ticko4.github.io/prefs.js:297
msgid "Per-core gauge"
msgstr "Ukazovateľ pre každé jadro"

#: resource-bar@ticko4.github.io/prefs.js:298
msgid "For CPU usage in gauge mode, one bar per core"
msgstr "Pri využití CPU v režime ukazovateľa jeden stĺpec na každé jadro"

#: resource-bar@ticko4.github.io/prefs.js:301
msgid "Minimum value width"
msgstr "Minimálna šírka hodnoty"

#: resource-bar@ticko4.github.io/prefs.js:302
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "V pixeloch; vyhradí miesto, aby sa horná lišta neposúvala"

#: resource-bar@ticko4.github.io/prefs.js:303
msgid "Spacing between metrics"
msgstr "Rozostup medzi metrikami"

#: resource-bar@ticko4.github.io/prefs.js:305
msgid "Smooth animation"
msgstr "Plynulá animácia"

#: resource-bar@ticko4.github.io/prefs.js:306
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Ukazovatele a grafy plynulo prechádzajú medzi meraniami namiesto skokov pri "
"každej aktualizácii"

#: resource-bar@ticko4.github.io/prefs.js:307
msgid "Graph colors"
msgstr "Farby grafov"

#: resource-bar@ticko4.github.io/prefs.js:308
msgid "Applies to graphs and pills only"
msgstr "Platí len pre grafy a pilulky"

#: resource-bar@ticko4.github.io/prefs.js:309
msgid "Time shown in graphs"
msgstr "Časový úsek v grafoch"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "30 seconds"
msgstr "30 sekúnd"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "1 minute"
msgstr "1 minúta"

#: resource-bar@ticko4.github.io/prefs.js:310
msgid "2 minutes"
msgstr "2 minúty"

#: resource-bar@ticko4.github.io/prefs.js:310
#: resource-bar@ticko4.github.io/prefs.js:353
msgid "5 minutes"
msgstr "5 minút"

#: resource-bar@ticko4.github.io/prefs.js:313
msgid "Alert color"
msgstr "Farba upozornenia"

#: resource-bar@ticko4.github.io/prefs.js:314
msgid "Used when a value goes past its activity and critical thresholds"
msgstr "Použije sa, keď hodnota prekročí prah aktivity a kritický prah"

#: resource-bar@ticko4.github.io/prefs.js:335
msgid "Reset to default"
msgstr "Obnoviť predvolené"

#: resource-bar@ticko4.github.io/prefs.js:348
msgid "Menu"
msgstr "Ponuka"

#: resource-bar@ticko4.github.io/prefs.js:349
msgid "Top processes"
msgstr "Najnáročnejšie procesy"

#: resource-bar@ticko4.github.io/prefs.js:351
msgid "Processes using the most CPU or memory, listed in the menu"
msgstr "Procesy využívajúce najviac CPU alebo pamäte, uvedené v ponuke"

#: resource-bar@ticko4.github.io/prefs.js:352
msgid "CPU average"
msgstr "Priemer CPU"

#: resource-bar@ticko4.github.io/prefs.js:354
msgid "Time span of the processes’ CPU usage; memory is the current value"
msgstr "Obdobie využitia CPU procesmi; pamäť je aktuálna hodnota"

#: resource-bar@ticko4.github.io/prefs.js:358
msgid "Position"
msgstr "Umiestnenie"

#: resource-bar@ticko4.github.io/prefs.js:359
msgid "Top bar area"
msgstr "Oblasť hornej lišty"

#: resource-bar@ticko4.github.io/prefs.js:360
msgid "Position in the area"
msgstr "Pozícia v oblasti"

#: resource-bar@ticko4.github.io/prefs.js:361
msgid "0 = first item; -1 = last"
msgstr "0 = prvá položka; -1 = posledná"

#: resource-bar@ticko4.github.io/prefs.js:370
msgid "Monitoring"
msgstr "Sledovanie"

#: resource-bar@ticko4.github.io/prefs.js:372
msgid "General"
msgstr "Všeobecné"

#: resource-bar@ticko4.github.io/prefs.js:373
msgid "Update interval"
msgstr "Interval aktualizácie"

#: resource-bar@ticko4.github.io/prefs.js:374
msgid "Seconds between readings"
msgstr "Počet sekúnd medzi meraniami"

