#. TRANSLATORS: %s is a list of disk names.
#: resource-bar@ticko4.github.io/prefs.js:261
msgid "Adds “Disk used (%)” for: %s"
msgstr "Pridá „Obsadené miesto na disku (%)“ pre: %s"

#: resource-bar@ticko4.github.io/prefs.js:262
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "Všetkých %d zistených diskov už je na hornej lište"
msgstr[1] "%d zistený disk už je na hornej lište"
msgstr[2] "Všetky %d zistené disky už sú na hornej lište"

#: resource-bar@ticko4.github.io/prefs.js:266
msgid "Add all"
msgstr "Pridať všetky"

#: resource-bar@ticko4.github.io/prefs.js:284
msgid "Appearance"
msgstr "Vzhľad"

