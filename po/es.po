#: resource-bar@ticko4.github.io/prefs.js:146
msgid "Top Bar"
msgstr "Barra superior"

#: resource-bar@ticko4.github.io/prefs.js:149
msgid "Metrics in the top bar"
msgstr "Métricas en la barra superior"

#: resource-bar@ticko4.github.io/prefs.js:150
msgid ""
"Each metric becomes an item with an icon, a gauge or graph and its value, "
"like Noctalia’s sysmon widget."
msgstr ""
"Cada métrica se convierte en un elemento con un icono, un medidor o gráfico "
"y su valor, como el widget sysmon de Noctalia."

#: resource-bar@ticko4.github.io/prefs.js:173
#, javascript-format
msgid "default (%s)"
msgstr "predeterminado (%s)"

#: resource-bar@ticko4.github.io/prefs.js:190
msgid "Move up"
msgstr "Subir"

#: resource-bar@ticko4.github.io/prefs.js:195
msgid "Move down"
msgstr "Bajar"

#: resource-bar@ticko4.github.io/prefs.js:200
msgid "Remove"
msgstr "Quitar"

#: resource-bar@ticko4.github.io/prefs.js:207
msgid "Add metric"
msgstr "Añadir métrica"

#: resource-bar@ticko4.github.io/prefs.js:210
#, javascript-format
msgid "Default (%s)"
msgstr "Predeterminado (%s)"

#: resource-bar@ticko4.github.io/prefs.js:212
msgid "Disk"
msgstr "Disco"

#: resource-bar@ticko4.github.io/prefs.js:220
msgid "Add"
msgstr "Añadir"

#: resource-bar@ticko4.github.io/prefs.js:241
msgid "All disks"
msgstr "Todos los discos"

#. TRANSLATORS: %s is a list of disk names.
#: resource-bar@ticko4.github.io/prefs.js:244
msgid "Adds “Disk used (%)” for: %s"
msgstr "Añade «Disco usado (%)» para: %s"

#: resource-bar@ticko4.github.io/prefs.js:245
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "El %d disco detectado ya está en la barra superior"
msgstr[1] "Los %d discos detectados ya están en la barra superior"

#: resource-bar@ticko4.github.io/prefs.js:249
msgid "Add all"
msgstr "Añadir todos"

#: resource-bar@ticko4.github.io/prefs.js:267
msgid "Appearance"
msgstr "Apariencia"

#: resource-bar@ticko4.github.io/prefs.js:268
msgid "Visualization"
msgstr "Visualización"

#: resource-bar@ticko4.github.io/prefs.js:269
msgid "Vertical pill gauge or a graph of the last 30 readings"
msgstr ""
"Medidor vertical en forma de píldora o gráfico de las últimas 30 lecturas"

#: resource-bar@ticko4.github.io/prefs.js:270
msgid "Show icon"
msgstr "Mostrar icono"

#: resource-bar@ticko4.github.io/prefs.js:271
msgid "Show value"
msgstr "Mostrar valor"

#: resource-bar@ticko4.github.io/prefs.js:272
msgid "Show units"
msgstr "Mostrar unidades"

#: resource-bar@ticko4.github.io/prefs.js:272
msgid "Off: “45” instead of “45°C”"
msgstr "Desactivado: «45» en lugar de «45°C»"

#: resource-bar@ticko4.github.io/prefs.js:273
msgid "Per-core gauge"
msgstr "Medidor por núcleo"

#: resource-bar@ticko4.github.io/prefs.js:274
msgid "For CPU usage in gauge mode, one bar per core"
msgstr "Para el uso de la CPU en modo medidor, una barra por núcleo"

#: resource-bar@ticko4.github.io/prefs.js:275
msgid "Minimum value width"
msgstr "Anchura mínima del valor"

#: resource-bar@ticko4.github.io/prefs.js:276
msgid "In pixels; reserves room so the top bar does not shift"
msgstr "En píxeles; reserva espacio para que la barra superior no se desplace"

#: resource-bar@ticko4.github.io/prefs.js:277
msgid "Spacing between metrics"
msgstr "Espacio entre métricas"

#: resource-bar@ticko4.github.io/prefs.js:279
msgid "Smooth animation"
msgstr "Animación suave"

#: resource-bar@ticko4.github.io/prefs.js:280
msgid ""
"Gauges and graphs glide between readings instead of jumping on every update"
msgstr ""
"Los medidores y gráficos se deslizan entre lecturas en lugar de saltar en "
"cada actualización"

#: resource-bar@ticko4.github.io/prefs.js:281
msgid "Graph colors"
msgstr "Colores de los gráficos"

#: resource-bar@ticko4.github.io/prefs.js:282
msgid "Only graphs change; gauges, icons and values stay as they are"
msgstr ""
"Solo cambian los gráficos; los medidores, iconos y valores se mantienen igual"

#: resource-bar@ticko4.github.io/prefs.js:285
msgid "Alert color"
msgstr "Color de alerta"

#: resource-bar@ticko4.github.io/prefs.js:286
msgid "Used when a value goes past its activity and critical thresholds"
msgstr "Se usa cuando un valor supera sus umbrales de actividad y crítico"

#: resource-bar@ticko4.github.io/prefs.js:307
msgid "Reset to default"
msgstr "Restablecer predeterminado"

#: resource-bar@ticko4.github.io/prefs.js:320
msgid "Menu"
msgstr "Menú"

#: resource-bar@ticko4.github.io/prefs.js:321
msgid "Top processes"
msgstr "Procesos principales"

#: resource-bar@ticko4.github.io/prefs.js:323
msgid "Processes using the most CPU or memory, listed in the menu"
msgstr "Procesos que más CPU o memoria usan, listados en el menú"

#: resource-bar@ticko4.github.io/prefs.js:324
msgid "CPU average"
msgstr "Promedio de CPU"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "30 seconds"
msgstr "30 segundos"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "1 minute"
msgstr "1 minuto"

#: resource-bar@ticko4.github.io/prefs.js:325
msgid "5 minutes"
msgstr "5 minutos"

#: resource-bar@ticko4.github.io/prefs.js:326
msgid "Time span of the processes’ CPU usage; memory is the current value"
msgstr "Periodo del uso de CPU de los procesos; la memoria es el valor actual"

#: resource-bar@ticko4.github.io/prefs.js:330
msgid "Position"
msgstr "Posición"

#: resource-bar@ticko4.github.io/prefs.js:331
msgid "Top bar area"
msgstr "Área de la barra superior"

#: resource-bar@ticko4.github.io/prefs.js:332
msgid "Position in the area"
msgstr "Posición en el área"

#: resource-bar@ticko4.github.io/prefs.js:333
msgid "0 = first item; -1 = last"
msgstr "0 = primer elemento; -1 = último"

#: resource-bar@ticko4.github.io/prefs.js:342
msgid "Monitoring"
msgstr "Monitorización"

#: resource-bar@ticko4.github.io/prefs.js:344
msgid "General"
msgstr "General"

#: resource-bar@ticko4.github.io/prefs.js:345
msgid "Update interval"
msgstr "Intervalo de actualización"

#: resource-bar@ticko4.github.io/prefs.js:346
msgid "Seconds between readings"
msgstr "Segundos entre lecturas"

#: resource-bar@ticko4.github.io/prefs.js:347
msgid "Pause in fullscreen"
msgstr "Pausar en pantalla completa"

#: resource-bar@ticko4.github.io/prefs.js:348
msgid "Stop reading data while a fullscreen app or game hides the top bar"
msgstr "Dejar de leer datos mientras una aplicación o un juego a pantalla completa oculta la barra superior"

#: resource-bar@ticko4.github.io/prefs.js:352
msgid "Default disk"
msgstr "Disco predeterminado"

#: resource-bar@ticko4.github.io/prefs.js:353
msgid ""
"Used by disk metrics that do not name a specific disk. The menu always lists "
"every disk."
msgstr ""
"Lo usan las métricas de disco que no indican un disco concreto. El menú "
"siempre muestra todos los discos."

#: resource-bar@ticko4.github.io/prefs.js:356
msgid "Mount point"
msgstr "Punto de montaje"

#: resource-bar@ticko4.github.io/prefs.js:367
#: resource-bar@ticko4.github.io/lib/popup.js:298
msgid "Network"
msgstr "Red"

#: resource-bar@ticko4.github.io/prefs.js:372
msgid "Interface"
msgstr "Interfaz"

#: resource-bar@ticko4.github.io/prefs.js:373
msgid "Automatic (physical interfaces)"
msgstr "Automática (interfaces físicas)"

#: resource-bar@ticko4.github.io/prefs.js:374
msgid "Unit"
msgstr "Unidad"

#: resource-bar@ticko4.github.io/prefs.js:375
msgid "Compact format"
msgstr "Formato compacto"

#: resource-bar@ticko4.github.io/prefs.js:375
msgid "E.g. “1.2M” instead of “1.2 MB/s”"
msgstr "P. ej.: «1.2M» en lugar de «1.2 MB/s»"

