msgstr "Color de acento del sistema"

#: resource-bar@ticko4.github.io/prefs.js:23
msgid "Per resource (like Resources)"
msgstr "Por recurso (como en Resources)"

#: resource-bar@ticko4.github.io/prefs.js:27
