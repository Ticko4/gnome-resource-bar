msgstr "يضيف “المساحة المستخدمة من القرص (%)” للأقراص: %s"

#: resource-bar@ticko4.github.io/prefs.js:212
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "كل الأقراص المكتشفة (%d) موجودة بالفعل في الشريط العلوي"
msgstr[1] "القرص المكتشف موجود بالفعل في الشريط العلوي"
msgstr[2] "القرصان المكتشفان موجودان بالفعل في الشريط العلوي"
msgstr[3] "كل الأقراص المكتشفة (%d) موجودة بالفعل في الشريط العلوي"
