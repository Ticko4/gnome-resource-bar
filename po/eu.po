msgstr "“Erabilitako diskoa (%)” gehitzen du hauentzat: %s"

#: resource-bar@ticko4.github.io/prefs.js:262
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "Detektatutako %d diskoa goiko barran dago dagoeneko"
msgstr[1] "Detektatutako %d disko guztiak goiko barran daude dagoeneko"

