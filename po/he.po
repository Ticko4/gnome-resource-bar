#: resource-bar@ticko4.github.io/prefs.js:244
msgid "Adds “Disk used (%)” for: %s"
msgstr "מוסיף “נפח מנוצל בכונן (%)” עבור: %s"

#: resource-bar@ticko4.github.io/prefs.js:245
#, javascript-format
msgid "The %d detected disk is already in the top bar"
msgid_plural "All %d detected disks are already in the top bar"
msgstr[0] "הכונן שזוהה כבר נמצא בלוח העליון"
msgstr[1] "שני הכוננים שזוהו כבר נמצאים בלוח העליון"
msgstr[2] "כל %d הכוננים שזוהו כבר נמצאים בלוח העליון"
msgstr[3] "כל %d הכוננים שזוהו כבר נמצאים בלוח העליון"

